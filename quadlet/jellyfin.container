[Unit]
Description=Jellyfin media server
Requires=rclone-homelab.service
After=rclone-homelab.service network-online.target

[Container]
Image=docker.io/jellyfin/jellyfin:10.10.3
ContainerName=jellyfin
Environment=TZ=Asia/Kolkata
PublishPort=127.0.0.1:8096:8096
Volume=/home/abhay/homelab/jellyfin/data/config:/config:Z
Volume=/home/abhay/homelab/jellyfin/data/cache:/cache:Z
Volume=/mnt/homelab/media:/media:ro,rslave
NoNewPrivileges=true

[Service]
ExecStartPre=/usr/bin/mountpoint -q /mnt/homelab
Restart=always

[Install]
WantedBy=default.target
