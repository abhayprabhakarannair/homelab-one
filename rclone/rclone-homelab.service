[Unit]
Description=rclone mount homelab-storage-one-combined on /mnt/homelab
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/rclone mount homelab-storage-one-combined: /mnt/homelab \
    --config=/home/abhay/.config/rclone/rclone.conf \
    --read-only \
    --vfs-cache-mode=off \
    --buffer-size=16M \
    --dir-cache-time=12h \
    --log-file=/home/abhay/.local/state/rclone-homelab.log \
    --log-level=INFO
ExecStop=/usr/bin/fusermount3 -u /mnt/homelab
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
